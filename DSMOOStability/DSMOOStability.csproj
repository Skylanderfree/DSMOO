<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>DSMOO.Stability</PackageId>
        <Version>0.1.0</Version>
        <Authors>Dimenzio</Authors>
        <Description>DSMOO Extension for reducing lag</Description>
        <PackageTags>smoo;plugin</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <RepositoryUrl>https://github.com/Skylanderfree/DSMOO</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <AssemblyVersion>0.1.0</AssemblyVersion>

        <FileVersion>0.1.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DSMOOFramework\DSMOOFramework.csproj"/>
        <ProjectReference Include="..\DSMOOServer\DSMOOServer.csproj"/>
    </ItemGroup>

</Project>
